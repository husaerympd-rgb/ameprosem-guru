    function renderProsemTable() {
      const user = getCurrentUser();
      if (!user) return;
      const targetSemLabel = activeProsemSemester === 'ganjil' ? 'Ganjil' : 'Genap';
      const distMap = activeProsemSemester === 'ganjil' ? user.prosemGanjilDist : user.prosemGenapDist;
      const items = (user.prota || []).filter(p => p.semester === targetSemLabel);
      const tbody = document.getElementById('prosem-table-body');

      let totalTarget = 0;
      let totalDist = 0;

      if (items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="34" class="py-8 text-center font-sans text-slate-400 italic">Belum ada materi PROTA untuk Semester ${targetSemLabel}. Tambahkan di menu PROTA terlebih dahulu.</td></tr>`;
      } else {
        tbody.innerHTML = items.map((item, idx) => {
          const rowArr = distMap[item.id] || Array(30).fill(0);
          const rowSum = rowArr.reduce((acc, v) => acc + (parseInt(v) || 0), 0);
          totalTarget += parseInt(item.jp) || 0;
          totalDist += rowSum;

          const cells = rowArr.map((val, wIdx) => {
            const v = parseInt(val) || 0;
            const bg = v > 0 ? 'bg-indigo-100 text-indigo-900 font-bold' : 'bg-white text-slate-400';
            return `<td class="p-0.5 border-r border-slate-200">
              <input type="number" min="0" max="10" value="${v || ''}" onchange="updateProsemCell('${item.id}', ${wIdx}, this.value)"
                class="w-7 h-7 text-center text-[11px] rounded ${bg} outline-none focus:ring-1 focus:ring-indigo-500">
            </td>`;
          }).join('');

          const sumColor = rowSum === item.jp ? 'text-emerald-700 bg-emerald-50' : 'text-amber-700 bg-amber-50';

          return `
            <tr class="hover:bg-slate-50">
              <td class="p-2 border-r border-slate-200 font-sans text-slate-500">${idx + 1}</td>
              <td class="p-2 border-r border-slate-200 font-sans text-left text-slate-800 font-medium">${item.materi}</td>
              <td class="p-2 border-r border-slate-200 font-sans font-bold bg-indigo-50/70 text-indigo-900">${item.jp}</td>
              ${cells}
              <td class="p-2 font-sans font-bold ${sumColor}">${rowSum}</td>
            </tr>
          `;
        }).join('');
      }

      document.getElementById('prosem-foot-target').textContent = totalTarget;
      document.getElementById('prosem-foot-distributed').textContent = totalDist;
    }

    function updateProsemCell(protaId, weekIdx, val) {
      const user = getCurrentUser();
      if (!user) return;
      const distMap = activeProsemSemester === 'ganjil' ? user.prosemGanjilDist : user.prosemGenapDist;
      if (!distMap[protaId]) distMap[protaId] = Array(30).fill(0);
      distMap[protaId][weekIdx] = Math.max(0, parseInt(val) || 0);
      saveAppState();
      renderProsemTable();
      updateDashboardUI();
    }

    function autoDistributeProsem() {
      const user = getCurrentUser();
      if (!user) return;
      const targetSemLabel = activeProsemSemester === 'ganjil' ? 'Ganjil' : 'Genap';
      const items = (user.prota || []).filter(p => p.semester === targetSemLabel);
      if (items.length === 0) {
        showToast('Tidak ada materi PROTA pada semester ini untuk dibagi.', 'warning');
        return;
      }

      const ameMonths = user.ame[activeProsemSemester];
      const jpPerWeek = parseInt(user.ame.jpPerWeek) || 3;

      const effectiveSlots = [];
      ameMonths.forEach((m, mIdx) => {
        const effCount = Math.max(0, (parseInt(m.kalender) || 0) - (parseInt(m.nonEff) || 0));
        const startSlot = mIdx * 5 + (mIdx === 0 ? 1 : 0);
        for (let w = 0; w < effCount; w++) {
          const slot = Math.min(mIdx * 5 + 4, startSlot + w);
          effectiveSlots.push(slot);
        }
      });

      const newDist = {};
      let slotCursor = 0;

      items.forEach(item => {
        const arr = Array(30).fill(0);
        let remaining = parseInt(item.jp) || 0;
        while (remaining > 0 && effectiveSlots.length > 0) {
          const slot = effectiveSlots[slotCursor % effectiveSlots.length];
          const alloc = Math.min(jpPerWeek, remaining);
          arr[slot] += alloc;
          remaining -= alloc;
          slotCursor++;
        }
        newDist[item.id] = arr;
      });

      if (activeProsemSemester === 'ganjil') user.prosemGanjilDist = newDist;
      else user.prosemGenapDist = newDist;

      saveAppState();
      renderProsemTable();
      updateDashboardUI();
      showToast(`Distribusi JP Semester ${targetSemLabel} berhasil dipetakan otomatis!`);
    }

