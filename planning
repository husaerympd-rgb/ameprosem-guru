        const bodyRows = items.map((item, idx) => {
          const arr = distMap[item.id] || Array(30).fill(0);
          const cells = arr.map(v => `<td style="border:1px solid #333; padding:2px; text-align:center; font-size:9px; background:${v > 0 ? '#dbeafe' : '#fff'};">${v > 0 ? v : ''}</td>`).join('');
          return `
            <tr>
              <td style="border:1px solid #333; padding:4px; text-align:center;">${idx + 1}</td>
              <td style="border:1px solid #333; padding:4px;">${item.materi}</td>
              <td style="border:1px solid #333; padding:4px; text-align:center; font-weight:bold;">${item.jp}</td>
              ${cells}
            </tr>
          `;
        }).join('');

        return `
          <div style="font-weight:bold; font-size:12px; margin:12px 0 6px 0;">SEMESTER ${semLabel.toUpperCase()}</div>
          <table style="width:100%; border-collapse:collapse; font-size:10px;">
            <thead>
              <tr style="background:#f1f5f9;">
                <th rowspan="2" style="border:1px solid #333; padding:4px;">No</th>
                <th rowspan="2" style="border:1px solid #333; padding:4px;">Materi Pokok</th>
                <th rowspan="2" style="border:1px solid #333; padding:4px;">JP</th>
                ${months.map(m => `<th colspan="5" style="border:1px solid #333; padding:3px;">${m}</th>`).join('')}
              </tr>
              <tr style="background:#f8fafc; font-size:8px;">
                ${Array(6).fill('<th>1</th><th>2</th><th>3</th><th>4</th><th>5</th>').join('').replace(/<th>/g, '<th style="border:1px solid #333; padding:2px;">')}
              </tr>
            </thead>
            <tbody>
              ${bodyRows || '<tr><td colspan="33" style="border:1px solid #333; padding:8px; text-align:center;">Belum ada data</td></tr>'}
            </tbody>
          </table>
        `;
      };

      return `
        ${buildKopHeader(p, 'PROGRAM SEMESTER (PROSEM) KURIKULUM MERDEKA')}
        ${renderSem('Ganjil', user.prosemGanjilDist || {}, ['Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'])}
        ${renderSem('Genap', user.prosemGenapDist || {}, ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'])}
        ${buildSignatureBlock(p)}
      `;
    }

    function renderPrintPreview() {
      const user = getCurrentUser();
      if (!user) return;
      const docType = document.getElementById('export-doc-type').value;
      const container = document.getElementById('print-area');

      if (docType === 'AME') container.innerHTML = generateAMEDocHTML(user);
      else if (docType === 'PROTA') container.innerHTML = generatePROTADocHTML(user);
      else if (docType === 'PROSEM') container.innerHTML = generatePROSEMDocHTML(user);
      else {
        container.innerHTML = `
          ${generateAMEDocHTML(user)}
          <div style="page-break-before: always; margin-top: 32px; border-top: 2px dashed #cbd5e1; padding-top: 24px;"></div>
          ${generatePROTADocHTML(user)}
          <div style="page-break-before: always; margin-top: 32px; border-top: 2px dashed #cbd5e1; padding-top: 24px;"></div>
          ${generatePROSEMDocHTML(user)}
        `;
      }
    }

    function downloadAsWordDoc() {
      renderPrintPreview();
      const user = getCurrentUser();
      if (!user) return;
      const docType = document.getElementById('export-doc-type').value;
      const content = document.getElementById('print-area').innerHTML;

      const htmlDoc = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head><meta charset='utf-8'><title>Administrasi Guru - ${docType}</title></head>
        <body style="font-family: Arial, sans-serif;">${content}</body>
        </html>
      `;

      const blob = new Blob(['\ufeff', htmlDoc], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${docType}_${(user.profile.nama || 'Guru').replace(/\s+/g, '_')}.doc`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast(`Dokumen Word (${docType}) berhasil diunduh!`);
    }

    function triggerPrintPDF() {
      renderPrintPreview();
      window.print();
    }

    // ==================== INITIALIZATION ====================
    function initAppForCurrentUser() {
      const user = getCurrentUser();
      if (!user) return;
      updateNavbarAndDashboard();
      populateProfileForm();
      renderAMETable();
      renderProtaTable();
      renderProsemTable();
      renderPrintPreview();
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderLoginSavedAccounts();
      if (appState && appState.isLoggedIn && appState.currentUser && appState.users[appState.currentUser]) {
        document.getElementById('auth-screen').classList.add('hidden');
        initAppForCurrentUser();
      } else {
        document.getElementById('auth-screen').classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
