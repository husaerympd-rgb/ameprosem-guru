      const deletingActive = (appState.currentUser === uid);
      delete appState.users[uid];

      const remainingKeys = Object.keys(appState.users);
      if (remainingKeys.length === 0) {
        appState.currentUser = null;
        appState.isLoggedIn = false;
        saveAppState();
        closeDeleteGuruModal();
        performLogout();
        showToast('Akun guru dihapus. Silakan daftar atau login kembali.');
