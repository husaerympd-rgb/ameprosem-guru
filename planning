    function renderProtaTable() {
      const user = getCurrentUser();
      if (!user) return;
      const stats = getAMEStats(user);
      const targetJP = stats.totalJP;
      let allocatedJP = 0;

      const tbody = document.getElementById('prota-table-body');
      if (!user.prota || user.prota.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 italic">Belum ada materi PROTA. Klik tombol "Tambah Materi / Bab" di atas untuk memulai.</td></tr>`;
      } else {
        tbody.innerHTML = user.prota.map((item, idx) => {
          const jp = parseInt(item.jp) || 0;
          allocatedJP += jp;
          const badgeSem = item.semester === 'Ganjil'
            ? 'bg-indigo-100 text-indigo-800'
            : 'bg-sky-100 text-sky-800';
          return `
            <tr class="hover:bg-slate-50 transition">
              <td class="py-3 px-3 text-center font-medium text-slate-500">${idx + 1}</td>
              <td class="py-3 px-3 text-center">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${badgeSem}">${item.semester}</span>
              </td>
              <td class="py-3 px-4 font-medium text-slate-700">${item.elemen}</td>
              <td class="py-3 px-4 text-slate-800">${item.materi}</td>
              <td class="py-3 px-4 text-center font-bold bg-indigo-50/60 text-indigo-900">${jp} JP</td>
              <td class="py-3 px-3 text-center no-print">
                <div class="flex items-center justify-center gap-1.5">
                  <button onclick="openEditProtaModal('${item.id}')" class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-lg" title="Edit">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <button onclick="deleteProtaItem('${item.id}')" class="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg" title="Hapus">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      document.getElementById('prota-target-display').textContent = `${targetJP} JP`;
      document.getElementById('prota-total-allocated').textContent = allocatedJP;
      document.getElementById('prota-total-target').textContent = targetJP;
      document.getElementById('prota-footer-total').textContent = `${allocatedJP} JP`;

      const pct = targetJP > 0 ? Math.min(100, Math.round((allocatedJP / targetJP) * 100)) : 0;
      const bar = document.getElementById('prota-progress-bar');
      const tag = document.getElementById('prota-status-tag');
      const msg = document.getElementById('prota-alert-msg');

      bar.style.width = `${pct}%`;
      if (targetJP > 0 && allocatedJP === targetJP) {
        bar.className = 'bg-emerald-500 h-3 rounded-full transition-all duration-300';
        tag.className = 'px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800';
        tag.textContent = 'Tepat 100% (Seimbang)';
        msg.className = 'mt-2 text-[11px] text-emerald-700 flex items-center gap-1 font-medium';
        msg.innerHTML = '<i class="fa-solid fa-check-circle"></i> Alokasi jam di Program Tahunan telah sesuai 100% dengan pagu AME.';
      } else if (allocatedJP > targetJP) {
        bar.className = 'bg-rose-500 h-3 rounded-full transition-all duration-300';
        tag.className = 'px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800';
        tag.textContent = `Melebihi Pagu (+${allocatedJP - targetJP} JP)`;
        msg.className = 'mt-2 text-[11px] text-rose-700 flex items-center gap-1 font-medium';
        msg.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> Total alokasi melebihi pagu AME sebesar ${allocatedJP - targetJP} JP. Silakan kurangi JP materi.`;
      } else {
        bar.className = 'bg-amber-500 h-3 rounded-full transition-all duration-300';
        tag.className = 'px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800';
        tag.textContent = `Belum Penuh (Sisa ${Math.max(0, targetJP - allocatedJP)} JP)`;
        msg.className = 'mt-2 text-[11px] text-amber-700 flex items-center gap-1 font-medium';
        msg.innerHTML = `<i class="fa-solid fa-circle-info"></i> Masih tersisa ${Math.max(0, targetJP - allocatedJP)} JP dari pagu AME yang belum dialokasikan.`;
      }
    }

