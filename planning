  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center space-x-3 text-xs sm:text-sm border border-slate-700">
      <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
      <span id="toast-message">Data berhasil disimpan!</span>
    </div>
  </div>

  <script>
    // ==================== KONFIGURASI PENYIMPANAN BERSIH (TANPA DATA DEMO) ====================
    const STORAGE_KEY = 'administrasi_guru_generator_clean_v1';

    // Bersihkan sisa penyimpanan versi lama yang masih mengandung data demo
    ['administrasi_guru_generator_db_v1', 'administrasi_guru_generator_db_v2'].forEach(oldKey => {
      try { localStorage.removeItem(oldKey); } catch (e) {}
    });

    const defaultAppState = {
      currentUser: null,
      isLoggedIn: false,
      users: {}
    };

    let appState = null;

    function loadAppState() {
      const mergedUsers = {};
      let savedCurrentUser = null;
      let savedIsLoggedIn = false;

      // Layer 1: window.name
      try {
        if (window.name && window.name.startsWith('AGG_CLEAN:')) {
          const parsedWin = JSON.parse(window.name.slice(10));
          if (parsedWin && parsedWin.users) {
            Object.assign(mergedUsers, parsedWin.users);
            if (parsedWin.currentUser) savedCurrentUser = parsedWin.currentUser;
            if (typeof parsedWin.isLoggedIn === 'boolean') savedIsLoggedIn = parsedWin.isLoggedIn;
          }
        }
      } catch (e) {}

      // Layer 2: localStorage
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.users) {
            Object.assign(mergedUsers, parsed.users);
            if (parsed.currentUser) savedCurrentUser = parsed.currentUser;
            if (typeof parsed.isLoggedIn === 'boolean') savedIsLoggedIn = parsed.isLoggedIn;
          }
        }
      } catch (e) {}

      // Layer 3: Active memory
      if (appState && appState.users) {
        Object.assign(mergedUsers, appState.users);
      }

      const userKeys = Object.keys(mergedUsers);
      const validCurrent = mergedUsers[savedCurrentUser] ? savedCurrentUser : (userKeys[0] || null);

      return {
        currentUser: validCurrent,
        isLoggedIn: Boolean(savedIsLoggedIn && validCurrent),
        users: mergedUsers
      };
    }

    function saveAppState() {
      const serialized = JSON.stringify(appState);
      try {
        localStorage.setItem(STORAGE_KEY, serialized);
      } catch (err) {}
      try {
        window.name = 'AGG_CLEAN:' + serialized;
      } catch (err) {}
    }

    function normalizeCredential(str) {
      return (str || '').replace(/[\s\u200B-\u200D\uFEFF]/g, '').toLowerCase();
    }

    appState = loadAppState();
    saveAppState();

    let activeAMESemester = 'ganjil';
    let activeProsemSemester = 'ganjil';

    // ==================== HELPER & TOAST ====================
    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const icon = document.getElementById('toast-icon');
      const text = document.getElementById('toast-message');
      if (!toast || !icon || !text) return;

      text.textContent = msg;
      icon.className = type === 'error'
        ? 'fa-solid fa-circle-exclamation text-rose-400 text-base'
        : type === 'warning'
        ? 'fa-solid fa-triangle-exclamation text-amber-400 text-base'
        : 'fa-solid fa-circle-check text-emerald-400 text-base';

      toast.classList.remove('translate-y-20', 'opacity-0');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3500);
    }

    function getCurrentUser() {
      if (!appState || !appState.users || !appState.currentUser) return null;
      return appState.users[appState.currentUser] || Object.values(appState.users)[0] || null;
    }

    // ==================== AUTHENTICATION & LOGIN ====================
    function renderLoginSavedAccounts() {
      const wrapper = document.getElementById('login-saved-accounts-wrapper');
      const container = document.getElementById('login-saved-accounts-list');
      if (!wrapper || !container || !appState || !appState.users) return;

      const entries = Object.entries(appState.users);
      if (entries.length === 0) {
        wrapper.classList.add('hidden');
        container.innerHTML = '';
        return;
      }

      wrapper.classList.remove('hidden');
      container.innerHTML = entries.map(([uid, u]) => `
        <button type="button" onclick="quickLogin('${uid}')" class="p-2 border border-slate-200 rounded-xl hover:bg-indigo-50/70 hover:border-indigo-300 text-left transition flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="font-bold text-slate-800 truncate">${u.profile.nama}</div>
            <div class="text-[10px] text-indigo-600 truncate">${u.email}</div>
          </div>
          <span class="px-2 py-0.5 rounded-lg bg-indigo-100 text-indigo-700 text-[10px] font-bold flex-shrink-0">Masuk</span>
        </button>
      `).join('');
    }

    function switchAuthBox(mode) {
      document.getElementById('auth-box-login').classList.toggle('hidden', mode !== 'login');
      document.getElementById('auth-box-register').classList.toggle('hidden', mode !== 'register');
      document.getElementById('auth-box-reset').classList.toggle('hidden', mode !== 'reset');
      if (mode === 'login') renderLoginSavedAccounts();
    }

    function isBelajarId(email) {
      const clean = normalizeCredential(email);
      return /^[a-z0-9._%+-]+@([a-z0-9-]+\.)*belajar\.id$/.test(clean);
    }

    function handleLoginSubmit(event) {
      event.preventDefault();
      const rawInput = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      const cleanInput = normalizeCredential(rawInput);

      appState = loadAppState();

      let matchedKey = null;
      for (const [key, userObj] of Object.entries(appState.users)) {
        const userEmailClean = normalizeCredential(userObj.email);
        const usernameOnly = userEmailClean.split('@')[0];
        if (userEmailClean === cleanInput || usernameOnly === cleanInput) {
          matchedKey = key;
          break;
        }
      }

      if (!matchedKey) {
        showToast('Akun Belajar.id belum terdaftar. Silakan klik "Daftar Akun Belajar.id" terlebih dahulu.', 'error');
        return;
      }

      const user = appState.users[matchedKey];
      if (user.password !== password) {
        showToast('Kata sandi yang Anda masukkan salah!', 'error');
        return;
      }

      appState.currentUser = matchedKey;
      appState.isLoggedIn = true;
      saveAppState();

      document.getElementById('auth-screen').classList.add('hidden');
      initAppForCurrentUser();
      showToast(`Selamat datang, ${user.profile.nama}!`);
    }

    function quickLogin(userKey) {
      appState = loadAppState();
      if (!appState.users[userKey]) {
        showToast('Akun tidak ditemukan.', 'error');
        return;
      }
      appState.currentUser = userKey;
      appState.isLoggedIn = true;
      saveAppState();

      document.getElementById('auth-screen').classList.add('hidden');
      initAppForCurrentUser();
      showToast(`Masuk sebagai ${appState.users[userKey].profile.nama}`);
    }

    function handleRegisterSubmit(event) {
      event.preventDefault();
      const nama = document.getElementById('reg-name').value.trim();
      const emailRaw = document.getElementById('reg-email').value.trim();
      const email = normalizeCredential(emailRaw);
      const mapel = document.getElementById('reg-mapel').value.trim();
      const password = document.getElementById('reg-password').value;

      if (!isBelajarId(email)) {
        showToast('Pendaftaran ditolak! Wajib menggunakan email resmi berakhiran .belajar.id', 'error');
        return;
      }

      appState = loadAppState();

      const existingEntry = Object.entries(appState.users).find(([, u]) => normalizeCredential(u.email) === email);
      if (existingEntry) {
        const [existKey, existUser] = existingEntry;
        existUser.password = password;
        existUser.profile.nama = nama;
        existUser.profile.mapel = mapel;
        appState.currentUser = existKey;
        appState.isLoggedIn = true;
        saveAppState();

        document.getElementById('form-register').reset();
        switchAuthBox('login');
        document.getElementById('auth-screen').classList.add('hidden');
        initAppForCurrentUser();
        showToast('Akun Belajar.id berhasil diperbarui & masuk otomatis!');
        return;
      }

      const uid = 'guru_' + Date.now();
      let detectedJenjang = 'SMA';
      if (email.includes('.smk.')) detectedJenjang = 'SMK';
      else if (email.includes('.slb.')) detectedJenjang = 'SLB';

      appState.users[uid] = {
        email: email,
        password: password,
        profile: {
          statusSekolah: 'NEGERI',
          jenjang: detectedJenjang,
          sekolah: 'Belum Diisi (Silakan Lengkapi Profil)',
          nama: nama,
          nip: '',
          nuptk: '',
          mapel: mapel,
          fase: 'Fase E (Kelas X)',
          tp: '2025/2026',
          kepsek: '-',
          nipKepsek: '-',
          titimangsa: 'Indonesia, Juli 2025'
        },
        ame: {
          jpPerWeek: 3,
          ganjil: [
            { bulan: 'Juli', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Agustus', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'September', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Oktober', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'November', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Desember', kalender: 0, nonEff: 0, ket: '' }
          ],
          genap: [
            { bulan: 'Januari', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Februari', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Maret', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'April', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Mei', kalender: 0, nonEff: 0, ket: '' },
            { bulan: 'Juni', kalender: 0, nonEff: 0, ket: '' }
          ]
        },
        prota: [],
        prosemGanjilDist: {},
        prosemGenapDist: {}
      };

      appState.currentUser = uid;
      appState.isLoggedIn = true;
      saveAppState();

      document.getElementById('form-register').reset();
      switchAuthBox('login');
      document.getElementById('auth-screen').classList.add('hidden');
      initAppForCurrentUser();
      showToast('Akun Belajar.id berhasil didaftarkan & tersimpan permanen!');
    }

    function handleResetSubmit(event) {
      event.preventDefault();
      const email = normalizeCredential(document.getElementById('reset-email').value);
      const newPassword = document.getElementById('reset-new-password').value;

      appState = loadAppState();

      let foundKey = null;
      for (const [k, u] of Object.entries(appState.users)) {
        if (normalizeCredential(u.email) === email) {
          foundKey = k;
          break;
        }
      }

      if (!foundKey) {
        showToast('Email Belajar.id tidak ditemukan dalam daftar akun terdaftar.', 'error');
        return;
      }

      appState.users[foundKey].password = newPassword;
      saveAppState();

      document.getElementById('form-reset').reset();
      document.getElementById('login-email').value = email;
      document.getElementById('login-password').value = newPassword;
      switchAuthBox('login');
      showToast('Kata sandi baru berhasil disimpan! Silakan login.');
    }

    function performLogout() {
      const activeUser = getCurrentUser();
      if (activeUser) {
        document.getElementById('login-email').value = activeUser.email;
        document.getElementById('login-password').value = activeUser.password;
      } else {
        document.getElementById('login-email').value = '';
        document.getElementById('login-password').value = '';
      }
      appState.isLoggedIn = false;
      saveAppState();
      renderLoginSavedAccounts();
      switchAuthBox('login');
      document.getElementById('auth-screen').classList.remove('hidden');
      showToast('Anda telah keluar dari sesi.');
    }

    // ==================== NAVIGATION & VIEW SWITCHING ====================
    function switchTab(tabName) {
      const views = ['dashboard', 'profile', 'ame', 'prota', 'prosem', 'export'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const btn = document.getElementById(`tab-btn-${v}`);
        if (el) el.classList.toggle('hidden', v !== tabName);
        if (btn) {
          if (v === tabName) {
            btn.className = 'tab-btn px-3 py-2 rounded-lg text-indigo-700 bg-indigo-50 flex items-center gap-2 transition whitespace-nowrap font-bold';
          } else {
            btn.className = 'tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap';
          }
        }
      });

      if (tabName === 'dashboard') updateDashboardUI();
      if (tabName === 'profile') populateProfileForm();
      if (tabName === 'ame') renderAMETable();
      if (tabName === 'prota') renderProtaTable();
      if (tabName === 'prosem') renderProsemTable();
      if (tabName === 'export') renderPrintPreview();
    }

    function scrollToRekapGuru() {
      const el = document.getElementById('section-rekap-guru');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }

    // ==================== CALCULATIONS & AME ====================
    function getAMEStats(userObj) {
      const user = userObj || getCurrentUser();
      if (!user) {
        return { jpPerWeek: 3, ganjilKal: 0, ganjilNon: 0, ganjilEff: 0, ganjilJP: 0, genapKal: 0, genapNon: 0, genapEff: 0, genapJP: 0, totalEffWeeks: 0, totalJP: 0 };
      }
      const ame = user.ame;
      const jpPerWeek = parseInt(ame.jpPerWeek) || 3;

      let ganjilKal = 0, ganjilNon = 0, ganjilEff = 0;
      ame.ganjil.forEach(m => {
        const k = parseInt(m.kalender) || 0;
        const n = Math.min(k, parseInt(m.nonEff) || 0);
        const eff = Math.max(0, k - n);
        ganjilKal += k;
        ganjilNon += n;
        ganjilEff += eff;
      });

      let genapKal = 0, genapNon = 0, genapEff = 0;
      ame.genap.forEach(m => {
        const k = parseInt(m.kalender) || 0;
        const n = Math.min(k, parseInt(m.nonEff) || 0);
        const eff = Math.max(0, k - n);
        genapKal += k;
        genapNon += n;
        genapEff += eff;
      });

      const ganjilJP = ganjilEff * jpPerWeek;
      const genapJP = genapEff * jpPerWeek;
      const totalEffWeeks = ganjilEff + genapEff;
      const totalJP = ganjilJP + genapJP;

      return {
        jpPerWeek,
        ganjilKal, ganjilNon, ganjilEff, ganjilJP,
        genapKal, genapNon, genapEff, genapJP,
        totalEffWeeks, totalJP
      };
    }

    function switchAMESemester(sem) {
      activeAMESemester = sem;
      const btnGanjil = document.getElementById('ame-tab-btn-ganjil');
      const btnGenap = document.getElementById('ame-tab-btn-genap');
      if (sem === 'ganjil') {
        btnGanjil.className = 'px-5 py-2.5 font-bold text-sm border-b-2 border-indigo-600 text-indigo-700 flex items-center gap-2';
        btnGenap.className = 'px-5 py-2.5 font-bold text-sm border-b-2 border-transparent text-slate-500 hover:text-indigo-600 flex items-center gap-2';
      } else {
        btnGenap.className = 'px-5 py-2.5 font-bold text-sm border-b-2 border-indigo-600 text-indigo-700 flex items-center gap-2';
        btnGanjil.className = 'px-5 py-2.5 font-bold text-sm border-b-2 border-transparent text-slate-500 hover:text-indigo-600 flex items-center gap-2';
      }
      renderAMETable();
    }

    function renderAMETable() {
      const user = getCurrentUser();
      if (!user) return;
      document.getElementById('ame-jp-per-week').value = user.ame.jpPerWeek;
      const rows = user.ame[activeAMESemester];
      const jpPerWeek = parseInt(user.ame.jpPerWeek) || 3;
      const tbody = document.getElementById('ame-table-body');

      let semKal = 0, semNon = 0, semEff = 0, semJP = 0;

      tbody.innerHTML = rows.map((row, idx) => {
        const k = parseInt(row.kalender) || 0;
        const n = Math.min(k, parseInt(row.nonEff) || 0);
        const eff = Math.max(0, k - n);
        const jp = eff * jpPerWeek;

        semKal += k;
        semNon += n;
        semEff += eff;
        semJP += jp;

        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-2.5 px-3 text-center font-medium text-slate-500">${idx + 1}</td>
            <td class="py-2.5 px-4 font-semibold text-slate-800">${row.bulan}</td>
            <td class="py-2.5 px-4 text-center">
              <input type="number" min="0" max="6" value="${k}" onchange="updateAMERow(${idx}, 'kalender', this.value)"
                class="w-16 text-center bg-slate-50 border border-slate-300 rounded-lg py-1 font-semibold focus:ring-2 focus:ring-indigo-500 outline-none">
            </td>
            <td class="py-2.5 px-4 text-center">
              <input type="number" min="0" max="6" value="${n}" onchange="updateAMERow(${idx}, 'nonEff', this.value)"
                class="w-16 text-center bg-slate-50 border border-slate-300 rounded-lg py-1 font-semibold text-rose-600 focus:ring-2 focus:ring-indigo-500 outline-none">
            </td>
            <td class="py-2.5 px-4">
              <input type="text" value="${row.ket || ''}" placeholder="Catatan agenda..." onchange="updateAMERow(${idx}, 'ket', this.value)"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1 text-xs focus:ring-2 focus:ring-indigo-500 outline-none">
            </td>
            <td class="py-2.5 px-4 text-center font-bold bg-indigo-50/60 text-indigo-800">${eff} Mgg</td>
            <td class="py-2.5 px-4 text-center font-bold bg-emerald-50/60 text-emerald-800">${jp} JP</td>
          </tr>
        `;
      }).join('');

      document.getElementById('ame-total-kalender').textContent = semKal;
      document.getElementById('ame-total-non-eff').textContent = semNon;
      document.getElementById('ame-total-eff').textContent = semEff;
      document.getElementById('ame-total-jp').textContent = `${semJP} JP`;

      const stats = getAMEStats(user);
      document.getElementById('ame-badge-ganjil').textContent = `${stats.ganjilJP} JP (${stats.ganjilEff} Minggu)`;
      document.getElementById('ame-badge-genap').textContent = `${stats.genapJP} JP (${stats.genapEff} Minggu)`;
      document.getElementById('ame-badge-total').textContent = `${stats.totalJP} JP (${stats.totalEffWeeks} Mgg)`;

      const compBadge = document.getElementById('ame-badge-compliance');
      if (stats.totalEffWeeks === 36) {
        compBadge.className = 'mt-1 inline-flex items-center justify-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-full';
        compBadge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Sesuai Asumsi 36 Minggu';
      } else {
        const diff = stats.totalEffWeeks - 36;
        const sign = diff > 0 ? `+${diff}` : `${diff}`;
        compBadge.className = 'mt-1 inline-flex items-center justify-center gap-1 text-xs font-bold text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full';
        compBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> Selisih ${sign} Mgg dari 36`;
      }
    }

