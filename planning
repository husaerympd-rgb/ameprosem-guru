<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administrasi Guru Generator - Belajar.id Ready</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    @media print {
      body * {
        visibility: hidden;
      }
      #print-area, #print-area * {
        visibility: visible;
      }
      #print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        background: white;
      }
      .no-print {
        display: none !important;
      }
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- ==================== VIEW 0: LOGIN & AUTH SCREEN ==================== -->
  <div id="auth-screen" class="fixed inset-0 z-50 bg-slate-900/90 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden relative my-8">
      
      <!-- Card Header -->
      <div class="bg-gradient-to-tr from-indigo-900 via-indigo-800 to-sky-800 p-6 text-white text-center relative">
        <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-sky-300 text-2xl shadow-inner">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h2 class="text-xl font-bold tracking-tight">Administrasi Guru Generator</h2>
        <p class="text-xs text-indigo-200 mt-1">Portal Kurikulum Merdeka • Terintegrasi Belajar.id</p>
        <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/20 text-sky-200 border border-sky-400/30">
          <i class="fa-solid fa-database"></i> Penyimpanan Multi-Layer Aktif
        </div>
      </div>

      <!-- Container: Form Login -->
      <div id="auth-box-login" class="p-6 sm:p-8 space-y-4">
        <div class="text-center">
          <h3 class="font-bold text-slate-800 text-base">Masuk dengan Akun Belajar.id</h3>
          <p class="text-xs text-slate-500 mt-1">Gunakan akun resmi Kemendikdasmen Anda</p>
        </div>

        <form id="form-login" onsubmit="handleLoginSubmit(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">
              Username / Email Belajar.id <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-sm">
                <i class="fa-regular fa-envelope"></i>
              </span>
              <input type="text" id="login-email" required placeholder="nama.anda@guru.sma.belajar.id" 
                class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white transition outline-none">
            </div>
            <p class="text-[10px] text-slate-400 mt-1">Contoh: @guru.sma.belajar.id, @guru.smk.belajar.id, atau @dinas.belajar.id</p>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-slate-700 uppercase">
                Kata Sandi <span class="text-rose-500">*</span>
              </label>
              <button type="button" onclick="switchAuthBox('reset')" class="text-xs text-indigo-600 hover:text-indigo-800 font-semibold hover:underline">
                Lupa Password?
              </button>
            </div>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-sm">
                <i class="fa-solid fa-lock"></i>
              </span>
              <input type="password" id="login-password" required placeholder="••••••••" 
                class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white transition outline-none">
            </div>
          </div>

          <div class="pt-1">
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-xs sm:text-sm shadow-md shadow-indigo-600/25 transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-arrow-right-to-bracket"></i> Masuk Sekarang
            </button>
          </div>
        </form>

        <!-- Daftar Akun Tersimpan (1-Klik Login) -->
        <div id="login-saved-accounts-wrapper">
          <div class="relative flex py-1.5 items-center">
            <div class="flex-grow border-t border-slate-200"></div>
            <span class="flex-shrink mx-3 text-[10px] text-slate-400 uppercase font-semibold">Akun Terdaftar (1-Klik Masuk)</span>
            <div class="flex-grow border-t border-slate-200"></div>
          </div>
          <div id="login-saved-accounts-list" class="grid grid-cols-1 gap-1.5 max-h-36 overflow-y-auto custom-scroll pr-0.5 text-xs">
            <!-- Dynamically populated with registered users -->
          </div>
        </div>

        <div class="text-center pt-2 border-t border-slate-100">
          <span class="text-xs text-slate-500">Belum punya akun?</span>
          <button type="button" onclick="switchAuthBox('register')" class="text-xs text-indigo-600 hover:text-indigo-800 font-bold ml-1 hover:underline">
            Daftar Akun Belajar.id
          </button>
        </div>

        <!-- Copyright Login -->
        <div class="text-center pt-2 border-t border-slate-100 text-[11px] text-slate-400 font-medium">
          <p><i class="fa-regular fa-copyright mr-1"></i>Copyright &copy; Ahmad Husairi-Pengawas SMK</p>
        </div>
      </div>

      <!-- Container: Form Registrasi (Belajar.id Strict) -->
      <div id="auth-box-register" class="hidden p-6 sm:p-8 space-y-4">
        <div class="text-center">
          <h3 class="font-bold text-slate-800 text-base">Pendaftaran Akun Baru</h3>
          <p class="text-xs text-slate-500 mt-1">Khusus pemilik email berdomain <strong>@*.belajar.id</strong></p>
        </div>

        <form id="form-register" onsubmit="handleRegisterSubmit(event)" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">
              Nama Lengkap beserta Gelar <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="reg-name" required placeholder="Contoh: Ahmad Subardjo, S.Pd." 
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">
              Email Akun Belajar.id <span class="text-rose-500">*</span>
            </label>
            <input type="email" id="reg-email" required placeholder="nama@guru.sma.belajar.id" 
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            <p id="reg-email-hint" class="text-[10px] text-indigo-600 mt-1 flex items-center gap-1">
              <i class="fa-solid fa-circle-info"></i> Wajib berakhiran domain <strong>.belajar.id</strong>
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">
              Mata Pelajaran yang Diampu <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="reg-mapel" required placeholder="Contoh: Biologi / Fisika / Informatika" 
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">
              Buat Kata Sandi <span class="text-rose-500">*</span>
            </label>
            <input type="password" id="reg-password" required minlength="6" placeholder="Minimal 6 karakter" 
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

          <div class="pt-2 flex gap-2">
            <button type="button" onclick="switchAuthBox('login')" class="w-1/3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">
              Kembali
            </button>
            <button type="submit" class="w-2/3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 rounded-xl text-xs shadow-md transition">
              <i class="fa-solid fa-user-plus mr-1"></i> Daftarkan Akun
            </button>
          </div>
        </form>
      </div>

      <!-- Container: Form Reset Password -->
      <div id="auth-box-reset" class="hidden p-6 sm:p-8 space-y-4">
        <div class="text-center">
          <div class="w-10 h-10 mx-auto rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-lg mb-2">
            <i class="fa-solid fa-key"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-base">Reset Kata Sandi</h3>
          <p class="text-xs text-slate-500 mt-1">Masukkan email belajar.id terdaftar untuk memperbarui kata sandi baru secara langsung.</p>
        </div>

        <form id="form-reset" onsubmit="handleResetSubmit(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">
              Email Belajar.id Terdaftar <span class="text-rose-500">*</span>
            </label>
            <input type="email" id="reset-email" required placeholder="nama@guru.sma.belajar.id" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">
              Kata Sandi Baru <span class="text-rose-500">*</span>
            </label>
            <input type="password" id="reset-new-password" required minlength="6" placeholder="Minimal 6 karakter" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

          <div class="pt-2 flex gap-2">
            <button type="button" onclick="switchAuthBox('login')" class="w-1/3 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">
              Batal
            </button>
            <button type="submit" class="w-2/3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-xs shadow-md transition">
              <i class="fa-solid fa-key mr-1"></i> Simpan Sandi Baru
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <!-- ==================== HEADER UTAMA ==================== -->
  <header class="bg-indigo-900 text-white shadow-md sticky top-0 z-40 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-400 to-indigo-500 flex items-center justify-center text-white font-bold shadow-lg shadow-sky-500/20">
          <i class="fa-solid fa-graduation-cap text-lg"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold leading-tight flex items-center gap-2">
            Administrasi Guru Generator
            <span class="text-xs bg-sky-500/30 text-sky-200 border border-sky-400/40 px-2 py-0.5 rounded-full font-medium hidden sm:inline-block">Kurikulum Merdeka</span>
          </h1>
          <p class="text-xs text-indigo-200">AME • PROTA • PROSEM Otomatis & Tersimpan Permanen</p>
        </div>
      </div>

      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- User Badge -->
        <div class="flex items-center space-x-2 bg-indigo-800/80 hover:bg-indigo-700/80 px-3 py-1.5 rounded-lg border border-indigo-700 transition cursor-pointer" onclick="openUserModal()">
          <div class="w-7 h-7 rounded-full bg-emerald-500 flex items-center justify-center text-xs font-bold text-white shadow">
            <span id="nav-avatar-initial">G</span>
          </div>
          <div class="text-left hidden md:block">
            <div id="nav-user-name" class="text-xs font-medium text-white truncate max-w-[140px]">-</div>
            <div id="nav-user-email" class="text-[10px] text-indigo-300 truncate max-w-[140px]">-</div>
          </div>
          <i class="fa-solid fa-chevron-down text-[10px] text-indigo-300 ml-1"></i>
        </div>

        <!-- Tombol Cetak Cepat -->
        <button onclick="switchTab('export')" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium px-3 py-2 rounded-lg flex items-center gap-1.5 shadow transition">
          <i class="fa-solid fa-print"></i>
          <span class="hidden sm:inline">Cetak Dokumen</span>
        </button>

        <!-- Tombol Logout Header -->
        <button onclick="performLogout()" class="bg-rose-600/90 hover:bg-rose-600 text-white text-xs font-semibold px-3 py-2 rounded-lg flex items-center gap-1.5 shadow transition" title="Keluar dari Aplikasi">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
          <span class="hidden sm:inline">Keluar</span>
        </button>
      </div>
    </div>
  </header>

  <nav class="bg-white border-b border-slate-200 sticky top-16 z-30 shadow-sm no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex space-x-1 sm:space-x-4 overflow-x-auto py-2.5 custom-scroll text-sm font-medium">
        <button id="tab-btn-dashboard" onclick="switchTab('dashboard')" class="tab-btn px-3 py-2 rounded-lg text-indigo-700 bg-indigo-50 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-chart-pie"></i>
          <span>Dashboard</span>
        </button>
        <button id="tab-btn-profile" onclick="switchTab('profile')" class="tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-school"></i>
          <span>Profil Sekolah & Guru</span>
        </button>
        <button id="tab-btn-ame" onclick="switchTab('ame')" class="tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-calendar-check"></i>
          <span>1. Analisis Minggu Efektif (AME)</span>
        </button>
        <button id="tab-btn-prota" onclick="switchTab('prota')" class="tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-list-check"></i>
          <span>2. Program Tahunan (PROTA)</span>
        </button>
        <button id="tab-btn-prosem" onclick="switchTab('prosem')" class="tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-table-cells"></i>
          <span>3. Program Semester (PROSEM)</span>
        </button>
        <button id="tab-btn-export" onclick="switchTab('export')" class="tab-btn px-3 py-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 flex items-center gap-2 transition whitespace-nowrap">
          <i class="fa-solid fa-file-export"></i>
          <span>Menu Cetak & Ekspor</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <div id="view-dashboard" class="space-y-6">
      <!-- Welcome Banner -->
      <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-sky-800 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
              <i class="fa-solid fa-shield-halved"></i> Terhubung Akun Belajar.id
            </span>
            <span id="dash-badge-status-sekolah" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-500/30 text-sky-200 border border-sky-400/30">
              Sekolah Negeri
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-500/30 text-indigo-200 border border-indigo-400/30">
              <i class="fa-solid fa-cloud-check"></i> Tersimpan Otomatis
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Selamat Datang, <span id="dash-greeting-name">-</span></h2>
          <p class="mt-2 text-indigo-100 text-sm leading-relaxed">
            Kelola seluruh administrasi perangkat ajar tahun pelajaran <span id="dash-tp-badge" class="font-semibold text-white">2025/2026</span> secara otomatis. Seluruh akun yang didaftarkan dan isian perangkat ajar disimpan secara permanen di perangkat Anda.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <button onclick="switchTab('ame')" class="bg-white text-indigo-900 font-semibold px-4 py-2 rounded-xl text-xs sm:text-sm hover:bg-slate-100 shadow transition flex items-center gap-2">
              <i class="fa-solid fa-bolt text-amber-500"></i> Mulai Susun AME
            </button>
            <button onclick="switchTab('profile')" class="bg-indigo-700/60 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-xl text-xs sm:text-sm border border-indigo-500/40 transition flex items-center gap-2">
              <i class="fa-solid fa-user-pen"></i> Perbarui Profil Guru
            </button>
            <button onclick="scrollToRekapGuru()" class="bg-sky-600/80 hover:bg-sky-600 text-white font-medium px-4 py-2 rounded-xl text-xs sm:text-sm border border-sky-400/40 transition flex items-center gap-2">
              <i class="fa-solid fa-users"></i> Rekap Guru Terdaftar
            </button>
            <!-- Tombol Logout di Dashboard -->
            <button onclick="performLogout()" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold px-4 py-2 rounded-xl text-xs sm:text-sm shadow transition flex items-center gap-2">
              <i class="fa-solid fa-power-off"></i> Logout (Keluar)
            </button>
          </div>
        </div>
        <div class="absolute -right-8 -bottom-10 opacity-10 text-white text-9xl pointer-events-none">
          <i class="fa-solid fa-book-open-reader"></i>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Card 1: Profil -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Identitas Guru</span>
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-sm">
              <i class="fa-solid fa-id-card"></i>
            </div>
          </div>
          <div class="mt-3">
            <div id="dash-stat-school" class="font-bold text-slate-800 text-base truncate">-</div>
            <div id="dash-stat-mapel" class="text-xs text-slate-500 truncate">-</div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-emerald-600 font-medium flex items-center gap-1">
              <i class="fa-solid fa-circle-check"></i> Profil Aktif
            </span>
            <button onclick="switchTab('profile')" class="text-indigo-600 hover:underline">Ubah</button>
          </div>
        </div>

        <!-- Card 2: AME -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Minggu Efektif (AME)</span>
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
              <i class="fa-solid fa-calendar-days"></i>
            </div>
          </div>
          <div class="mt-3">
            <div class="font-bold text-slate-800 text-xl"><span id="dash-stat-total-jp">0</span> <span class="text-xs font-normal text-slate-500">JP / Tahun</span></div>
            <div class="text-xs text-slate-500"><span id="dash-stat-eff-weeks">0</span> Pekan Efektif KBM</div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-emerald-600 font-medium flex items-center gap-1">
              <i class="fa-solid fa-circle-check"></i> Siap Dialokasikan
            </span>
            <button onclick="switchTab('ame')" class="text-indigo-600 hover:underline">Kelola</button>
          </div>
        </div>

        <!-- Card 3: PROTA -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Program Tahunan</span>
            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
              <i class="fa-solid fa-list-ol"></i>
            </div>
          </div>
          <div class="mt-3">
            <div class="font-bold text-slate-800 text-xl"><span id="dash-stat-prota-count">0</span> <span class="text-xs font-normal text-slate-500">Materi Pokok</span></div>
            <div class="text-xs text-slate-500">Alokasi: <span id="dash-stat-prota-allocated">0</span>/<span id="dash-stat-prota-target">0</span> JP</div>
          </div>
